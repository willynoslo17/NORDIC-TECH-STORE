type OrderItem={sku:string;name:string;quantity:number};
type OrderPayload={store:string;order_id:string;market:"NO"|"EU"|"PE";name:string;email:string;phone?:string;city:string;address:string;country:string;items:OrderItem[];consent:string};
const allowed=new Set(["NO","EU","PE"]);
function valid(b:OrderPayload){return b&&typeof b.store==="string"&&typeof b.order_id==="string"&&allowed.has(b.market)&&typeof b.name==="string"&&typeof b.email==="string"&&b.email.includes("@")&&typeof b.city==="string"&&typeof b.address==="string"&&Array.isArray(b.items)&&b.items.length>0&&b.consent==="accepted"}
export default async(req:Request)=>{if(req.method!=="POST")return Response.json({error:"Method not allowed"},{status:405});let b:OrderPayload;try{b=await req.json()}catch{return Response.json({error:"Invalid JSON"},{status:400})}if(!valid(b))return Response.json({error:"Invalid order"},{status:400});const hook=Netlify.env.get("MAKE_ORDERS_WEBHOOK");if(!hook)return Response.json({error:"Order automation is not configured"},{status:503});const clean={...b,items:b.items.slice(0,100).map(x=>({sku:String(x.sku||"").slice(0,100),name:String(x.name||"").slice(0,200),quantity:Math.max(1,Math.min(99,Number(x.quantity)||1))})),source:"netlify-store",received_at:new Date().toISOString()};const r=await fetch(hook,{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify(clean)});if(!r.ok)return Response.json({error:"Automation unavailable"},{status:502});return Response.json({ok:true,order_id:b.order_id,status:"received"},{status:202})};
export const config={path:"/api/order"};

