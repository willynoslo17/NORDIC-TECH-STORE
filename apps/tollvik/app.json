{
  "expo": {
    "name": "Tollvik",
    "slug": "tollvik",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "tollvik",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B2748"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "no.mlinternasjonal.tollvik",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B2748"
      },
      "package": "no.mlinternasjonal.tollvik",
      "versionCode": 1,
      "permissions": []
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#0B2748",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "appId": "tollvik",
      "paymentsBaseUrl": "",
      "aiWebhookUrl": "",
      "privacyUrl": "https://apps.mlinternasjonal.no/tollvik/privacy/",
      "supportUrl": "https://apps.mlinternasjonal.no/",
      "termsUrl": "https://apps.mlinternasjonal.no/tollvik/terms/",
      "pricingUrl": "https://apps.mlinternasjonal.no/tollvik/#pricing"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}